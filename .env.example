PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
ADMIN_EMAIL=your-admin-email@example.com
META_APP_ID=your-instagram-business-login-app-id
META_APP_SECRET=your-instagram-business-login-app-secret
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_API_VERSION=v25.0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=64-character-hex-key
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=nudge

# Razorpay Subscriptions (Test Mode: rzp_test_...)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cloudflare R2 Standard Storage (S3-Compatible API)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=comment2dm-assets
R2_S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://assets.yourdomain.com
